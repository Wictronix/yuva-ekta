{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yuva-ekta",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "yuva-ekta" }],
  // ISR / revalidatePath cache. Create once: see docs/DEPLOYMENT_CLOUDFLARE.md
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "yuva-ekta-next-cache" }],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "yuva-ekta-tag-cache",
      "database_id": "ff9b8a30-d9bc-4f3a-bc57-d985b29ccd99"
    }
  ],
  // Non-secret runtime vars. Secrets go in `wrangler secret put` / dashboard.
  "vars": {
    "R2_BUCKET": "yuva-ekta-assets",
    "EMAIL_FROM": "receipts@yuvaektaindiafoundation.org",
    "EMAIL_REPLY_TO": "yuvaekta2018@gmail.com",
    "TRANSACTION_FEE_PERCENT": "2.5"
  }
}
